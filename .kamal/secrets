# Secrets referenced by config/deploy.yml. Committed to git, so it only
# READS secrets from ENV / files — never contains raw values.
#
# Real values live in .env.deploy (gitignored), exported automatically by
# bin/deploy before every kamal command.
#
# NOTE: POSTGRES_PASSWORD is baked into the Postgres data directory on first
# boot. Pick it once and don't change it, or the DB accessory won't start.

POSTGRES_PASSWORD=$POSTGRES_PASSWORD

DATABASE_URL="postgres://rustrak:${POSTGRES_PASSWORD}@rustrak-db:5432/rustrak_production"

SESSION_SECRET_KEY=$SESSION_SECRET_KEY

# Baked into every generated project DSN — must be correct before any
# project is provisioned.
PUBLIC_URL=$PUBLIC_URL

# Bootstrap-only (see config/deploy.yml note).
CREATE_SUPERUSER=$CREATE_SUPERUSER

S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
